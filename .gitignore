# --- Build outputs ---
**/build/
**/.gradle/
**/.kotlin/
**/.cxx/
*.apk
*.aab
*.aar

# --- Local / secret config (never commit) ---
**/local.properties
**/keystore.properties
*.keystore
*.jks

# --- Go ---
**/vendor/

# --- IDE / OS ---
.idea/
*.iml
.DS_Store
Thumbs.db

# --- Logs ---
*.log

# iOS: generated from YPtun/iosApp/project.yml by XcodeGen
YPtun/iosApp/*.xcodeproj/

# Native Apple shell: generated from YPtun/apple/project.yml by XcodeGen
YPtun/apple/*.xcodeproj/
YPtun/apple/DerivedData/

# Apple Rust bridge generated by core/scripts/build-apple.sh
YPtun/apple/Packages/YPtunRustBridge/Artifacts/
YPtun/apple/Packages/YPtunRustBridge/Sources/YPtunRustBridge/Generated/
