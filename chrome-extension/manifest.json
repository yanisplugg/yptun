{
  "manifest_version": 3,
  "name": "YPtun VPN",
  "version": "3.4.2",
  "description": "VLESS and AmneziaWG straight in Chrome — the tunnel runs in the YPtun native host, the browser goes through it.",
  "permissions": ["proxy", "storage", "nativeMessaging", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" }
}
