{
    "log": {
        "level": "debug",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "remote",
                "type": "udp",
                "server": "8.8.8.8",
                "detour": "proxy"
            },
            {
                "tag": "direct",
                "type": "udp",
                "server": "77.88.8.8"
            }
        ],
        "rules": [],
        "final": "remote",
        "strategy": "ipv4_only"
    },
    "inbounds": [
        {
            "type": "socks",
            "tag": "socks-in",
            "listen": "127.0.0.1",
            "listen_port": 10808
        }
    ],
    "outbounds": [
        {
            "type": "hysteria2",
            "tag": "proxy",
            "server": "hy.example.com",
            "server_port": 443,
            "password": "hy-pass",
            "obfs": {
                "type": "salamander",
                "password": "obfspw"
            },
            "tls": {
                "enabled": true,
                "server_name": "hy.example.com",
                "insecure": false
            }
        },
        {
            "type": "direct",
            "tag": "direct"
        }
    ],
    "route": {
        "final": "proxy",
        "auto_detect_interface": false,
        "default_domain_resolver": {
            "server": "direct"
        },
        "rules": [
            {
                "action": "sniff"
            },
            {
                "protocol": [
                    "quic"
                ],
                "action": "reject"
            },
            {
                "network": "udp",
                "port": [
                    443
                ],
                "action": "reject"
            },
            {
                "domain_suffix": [
                    "cloudflare-dns.com",
                    "dns.google",
                    "dns.google.com",
                    "one.one.one.one",
                    "dns.quad9.net",
                    "doh.opendns.com",
                    "dns.nextdns.io",
                    "doh.cleanbrowsing.org",
                    "dns.adguard.com",
                    "dns.adguard-dns.com"
                ],
                "action": "reject"
            },
            {
                "domain": [
                    "use-application-dns.net"
                ],
                "action": "reject"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            },
            {
                "action": "resolve",
                "strategy": "ipv4_only"
            },
            {
                "ip_cidr": [
                    "::/0"
                ],
                "action": "reject",
                "method": "drop"
            }
        ]
    }
}
