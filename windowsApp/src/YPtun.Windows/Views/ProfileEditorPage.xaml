<Page
    x:Class="YPtun.WinUI.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="36,28,36,48" Spacing="18" MaxWidth="920" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Конфигурация" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Основные поля синхронизируются с полным JSON. Неизвестные и расширенные параметры сохраняются без потерь."
                               TextWrapping="Wrap" Opacity="0.64" Margin="0,5,0,0" />
                </StackPanel>

                <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />

                <Border Padding="22" CornerRadius="18" Background="{StaticResource YPtunCardBrush}">
                    <Grid ColumnSpacing="18" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" Header="Название" TextChanged="OnCommonFieldChanged" />
                        <ComboBox x:Name="EngineBox" Grid.Column="1" Header="Тип" SelectionChanged="OnCommonFieldChanged">
                            <ComboBoxItem Content="olcRTC" Tag="stealth" />
                            <ComboBoxItem Content="Прокси" Tag="standard" />
                            <ComboBoxItem Content="Каскад" Tag="chain" />
                            <ComboBoxItem Content="VK-TURN" Tag="vkturn" />
                            <ComboBoxItem Content="MasterDNS" Tag="masterdns" />
                            <ComboBoxItem Content="OpenFlux" Tag="openflux" />
                            <ComboBoxItem Content="snolc" Tag="snolc" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Padding="22" CornerRadius="18" Background="{StaticResource YPtunCardBrush}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Полная конфигурация" FontSize="18" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Right" Content="Форматировать" Click="OnFormat" />
                        </Grid>
                        <TextBox x:Name="JsonBox"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 MinHeight="420"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="Отмена" Click="OnCancel" />
                    <Button Content="Сохранить" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#66000000">
            <ProgressRing IsActive="True" Width="42" Height="42" />
        </Grid>
    </Grid>
</Page>
