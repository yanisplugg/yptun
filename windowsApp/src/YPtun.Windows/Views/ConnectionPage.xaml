<Page
    x:Class="YPtun.WinUI.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="36,28,36,40" MaxWidth="960" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Подключение" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Нативный клиент Windows · WinUI 3" Opacity="0.64" Margin="0,5,0,0" />
            </StackPanel>

            <Border Grid.Row="2" Padding="34" CornerRadius="24" Background="{StaticResource YPtunCardBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="7">
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConnectionDetail}" TextWrapping="Wrap" Opacity="0.68" MaxWidth="520" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,17,0,0">
                            <Border Padding="10,5" CornerRadius="10" Background="#147C5CFC">
                                <TextBlock Text="{Binding ConnectionMode}" FontWeight="SemiBold" />
                            </Border>
                            <Border Padding="10,5" CornerRadius="10" Background="#1000B7C3">
                                <TextBlock Text="Rust core" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Width="150"
                        Height="150"
                        Margin="38,0,0,0"
                        CornerRadius="75"
                        Click="OnToggleConnection"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBooleanConverter}}">
                        <StackPanel Spacing="7">
                            <FontIcon Glyph="&#xE7E8;" FontSize="34" />
                            <TextBlock Text="{Binding IsConnected, Converter={StaticResource ConnectionActionConverter}}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="4" Padding="24" CornerRadius="18" Background="{StaticResource YPtunCardBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="24" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="Активная конфигурация" Opacity="0.62" FontSize="12" />
                        <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue=Конфигурация не выбрана, TargetNullValue=Конфигурация не выбрана}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedProfile.Subtitle}" Opacity="0.65" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="6" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="22" CornerRadius="18" Background="{StaticResource YPtunCardBrush}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Состояние сеанса" Opacity="0.62" FontSize="12" />
                        <TextBlock Text="{Binding EngineHealth}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SessionDetail}" TextWrapping="Wrap" Opacity="0.68" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="22" CornerRadius="18" Background="{StaticResource YPtunCardBrush}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Прокси Telegram" Opacity="0.62" FontSize="12" />
                        <TextBlock Text="{Binding TelegramProxyStatus}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TelegramProxyDetail}" TextWrapping="Wrap" Opacity="0.68" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
