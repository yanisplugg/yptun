<Page
    x:Class="YPtun.WinUI.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36,28,36,32" MaxWidth="1040" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Журнал" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Диагностика интерфейса и VPN-движков" Opacity="0.64" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Копировать" VerticalAlignment="Bottom" Click="OnCopy" />
        </Grid>
        <ListView Grid.Row="2" x:Name="LogsList" ItemsSource="{Binding Logs}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Margin="4,2" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
