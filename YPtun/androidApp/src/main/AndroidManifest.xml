<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Split tunneling needs to enumerate ALL installed apps (incl. system/background packages with
         no launcher icon) so they can be included in / excluded from the tunnel. Distributed outside
         Google Play, so the QUERY_ALL_PACKAGES policy restriction doesn't apply. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="YPtun"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.YPtun"
        android:usesCleartextTraffic="true">

        <!-- Use our bundled EmojiCompat (init in App.onCreate) instead of the default
             downloadable-font initializer, so flag emojis render offline/everywhere.
             Also disable WorkManager's automatic startup initializer: it runs as a
             ContentProvider BEFORE Application.onCreate (uncatchable), so instead the app
             initializes WorkManager on-demand via Configuration.Provider, guarded in onCreate. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".AppActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleInstance"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links: yptun://import/{url|config}, yptun://control/{start|stop|restart} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yptun" />
            </intent-filter>
            <!--
                Long-pressing the Quick Settings tile launches the tile's
                "preferences" activity. Without this filter the system falls
                back to the App Info settings page; handling it here makes a
                long-press reliably open the app instead.
            -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.olcbox.app.ui.activities.QrScannerActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="org.olcbox.app.vpn.service.CaptchaActivity"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog"
            android:excludeFromRecents="true"
            android:exported="false" />

        <service
            android:name="org.olcbox.app.vpn.service.OlcboxVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
            Telegram-over-WARP background proxy: a separate lightweight foreground service that runs an
            AmneziaWG (Cloudflare WARP) tunnel and exposes a local SOCKS5 the user points Telegram at.
            Independent of the VPN service.
        -->
        <service
            android:name="org.olcbox.app.vpn.telegram.TelegramProxyService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="WARP proxy for Telegram" />
        </service>

        <!--
            Quick Settings tile — allows the user to toggle the VPN directly
            from the notification shade without opening the app.
            Requires Android 7.0+ (API 24). The tile must be added manually by
            the user via "Edit" in the Quick Settings panel.
        -->
        <service
            android:name=".QuickSettingsTileService"
            android:label="@string/qs_tile_label"
            android:icon="@drawable/ic_qs_tile_cat"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true"
            tools:targetApi="24">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

    </application>

</manifest>
