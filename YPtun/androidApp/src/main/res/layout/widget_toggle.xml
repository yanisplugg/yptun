<?xml version="1.0" encoding="utf-8"?>
<!-- Variant 1: a single power button. Tap = connect active location / disconnect. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_toggle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_toggle_power"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_power"
        android:contentDescription="@string/widget_toggle_label" />

</FrameLayout>
