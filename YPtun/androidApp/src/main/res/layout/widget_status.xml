<?xml version="1.0" encoding="utf-8"?>
<!--
  Full widget: power pill + active location + live speed + Auto / < > controls.
  Everything colourable is a plain white shape or a glyph tinted at runtime from WidgetStyle, so one
  layout renders the dark, light and transparent themes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_status_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_status_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_medium"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Power pill: a soft halo in the state colour with the glyph on top -->
        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp">

            <ImageView
                android:id="@+id/widget_status_power_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_circle"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/widget_status_power"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_power"
                android:contentDescription="@string/widget_toggle_label" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#66000000"
                android:shadowRadius="3"
                android:textColor="#ECEDEF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="@string/qs_tile_label" />

            <TextView
                android:id="@+id/widget_status_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="1dp"
                android:shadowColor="#66000000"
                android:shadowRadius="3"
                android:textColor="#AEB1B6"
                android:textSize="12sp"
                android:text="@string/widget_state_disconnected" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_status_controls"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_status_auto"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_auto"
                android:contentDescription="@string/widget_auto" />

            <ImageView
                android:id="@+id/widget_status_prev"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_prev"
                android:contentDescription="@string/widget_prev_node" />

            <ImageView
                android:id="@+id/widget_status_next"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:contentDescription="@string/widget_next_node" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
