<?xml version="1.0" encoding="utf-8"?>
<!-- Variant 2: power toggle + active location name + live speed + node switcher (‹ ›). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_status_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Toggle button -->
    <ImageView
        android:id="@+id/widget_status_power"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_power"
        android:contentDescription="@string/widget_toggle_label" />

    <!-- Name + speed -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#ECEDEF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/qs_tile_label" />

        <TextView
            android:id="@+id/widget_status_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#AEB1B6"
            android:textSize="12sp"
            android:text="@string/widget_state_disconnected" />

    </LinearLayout>

    <!-- Auto = fastest server -->
    <ImageView
        android:id="@+id/widget_status_auto"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_auto"
        android:contentDescription="@string/widget_auto" />

    <!-- Node switcher -->
    <ImageView
        android:id="@+id/widget_status_prev"
        android:layout_width="34dp"
        android:layout_height="40dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_prev"
        android:contentDescription="@string/widget_prev_node" />

    <ImageView
        android:id="@+id/widget_status_next"
        android:layout_width="34dp"
        android:layout_height="40dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_next"
        android:contentDescription="@string/widget_next_node" />

</LinearLayout>
